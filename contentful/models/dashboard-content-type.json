{ "contentTypes": [
  {
   "sys":{"id":"dashboard"}, 
  "name": "Dashboard",
  "description": "Main dashboard layout that aggregates all widget sections and data visualizations.",
  "displayField": "title",
  "fields": [
    {
      "id": "title",
      "name": "Title",
      "type": "Symbol",
      "required": true,
      "localized": false
    },
    {
      "id": "slug",
      "name": "Slug",
      "type": "Symbol",
      "required": true,
      "localized": false
    },
    {
      "id": "heroSection",
      "name": "Hero Section",
      "type": "Link",
      "linkType": "Entry",
      "required": false,
      "validations": [
        {
          "linkContentType": ["heroSection"]
        }
      ]
    },
    {
      "id": "widgets",
      "name": "Widgets",
      "type": "Array",
      "items": {
        "type": "Link",
        "linkType": "Entry",
        "validations": [
          {
            "linkContentType": [
              "statWidget",
              "chartWidget",
              "consumptionWidget",
              "performanceWidget",
              "trendWidget",
              "comparisonWidget",
              "usageWidget",
              "customWidget"
            ]
          }
        ]
      },
      "required": false
    },
    {
      "id": "lastUpdated",
      "name": "Last Updated",
      "type": "Date",
      "required": false,
      "localized": false
    }
  ] }
]
}
